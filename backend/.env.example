# ==============================================================================
# MEDISAVE Backend Environment Configuration Template
# Copy this file to .env and configure your local environment settings.
# NEVER commit the actual .env file or production secrets to source control.
# ==============================================================================

# Server port for the Express REST API
PORT=5000

# MongoDB Connection String (Local development or MongoDB Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/medisave

# JSON Web Token Secret Key for signing authentication tokens (Use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_change_in_production

# OpenRouter AI API Key (Used for medicine normalization, salt extraction, and pricing insights)
# Obtain your key from: https://openrouter.ai/keys
# Note: If no key is provided, the backend seamlessly falls back to the internal pharmaceutical knowledge base.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model Identifier (Default: Google Gemini 2.0 Flash)
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Platform Coordinator / Administrator Registration Security PIN (Default: MEDISAVE-ADMIN-2026)
ADMIN_SECURITY_KEY=MEDISAVE-ADMIN-2026
